# GraphQL schema example
#
# https://gqlgen.com/getting-started/
scalar Time
scalar Int64
enum ProjectRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum ChatStatus {
  ACTIVE
  GENERATING
  ARCHIVED
}

enum ChatType {
  GENERAL
  AI_ASSISTANT
}

enum MessageRole {
  USER
  AI
  SYSTEM
}

enum ProjectVisibility {
  PRIVATE
  TEAM
}

enum FilePermission {
  READ
  WRITE
}

enum ReportStatus {
  DRAFT
  GENERATING
  READY
  FAILED
}

enum FlowchartStatus {
  DRAFT
  GENERATING
  READY
  FAILED
}

enum ReportFormat {
  MARKDOWN
  PDF
  DOCX
}

type User {
  id:ID!
  username:String!
  email:String!
  profile:UserProfile
  ownedProjects:[Project]!
  projectMemberships:[ProjectMember!]!
  createdAt: Time!
  updatedAt: Time!
}

type UserProfile {
  user: User!
  firstName: String!
  lastName: String!
  bio: String
  avatarUrl: String
  createdAt: Time!
  updatedAt: Time!
}

type Project {
  id: ID!
  name: String!
  description: String!
  visibility: ProjectVisibility
  owner: User!
  archivedAt: Time
  createdAt: Time!
  updatedAt: Time!
}

type ProjectMember {
  id:ID!
  role: ProjectRole!
  createdAt: Time!
  user: User!
  project: Project!
  createdAt: Time!
  updatedAt: Time!  
}

type ProjectFiles {

}

type Folder {
  id: ID!
  projectID: Project!
  parentFolderId: Folder!
  name: String!
  createdAt: Time!
  updatedAt: Time!
}

type File {
  id: ID!
  name: String!
  size: Number!
  createdAt: Time!
  updatedAt: Time!
}

type FileStorage {

}

type FileProperties {

}

type FileShares {

}


type Chats {

}

type ChatMessages {

}

type ChatMetaData {

}

type FlowChats {

}

type Reports {

}

type ActivityLogs {
  
}