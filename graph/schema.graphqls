# GraphQL schema example
#
# https://gqlgen.com/getting-started/

scalar DateTime

enum Types{
  Report
  Project
}

type User {
  id: ID!
  name: String!
  email: String!
  password: String!
  createdAt: DateTime
  updatedAt: DateTime
}

# optional: Token type not needed when using AuthPayload

type Chat {
  id: ID!
  project_id: ID
  prompt: String!
  response: String!
  createdAt: DateTime
  updatedAt: DateTime
}

type File {
  id: ID!
  file_name: String!
  file_type: String!
  size: Int
  createdAt: DateTime
  updatedAt: DateTime
}

type Folder {
  id:ID!
  folder_name:String!
  folder_size:Int
  folder_items:[File!]!  
  createdAt:DateTime
  updatedAt: DateTime
}

type Project {
  id: ID!
  project_name: String!
  description: String
  chats: [Chat!]
  techStacks: [TechStack!]
  flowcharts: [Flowchart!]
}

type TechStack {
  Stacks:[String!]!
}

type Flowchart{
  id: ID!
  name: String!
  data: String!
}

type Query {
  getUsers: [User!]!
  getUserByID(id: ID!): User
  getUserByEmail(email: String!): User
  getUserByName(name: String!): User
  # Auth
  currentUser: User

  getFiles: [File!]!
  getFolders: [Folder]!
}

input NewUser {
  id: String!
  name:String!
  email:String!
  password:String!
}

type Mutation {
  createUser(input: NewUser!): User!
  updateUser(id: ID!, name: String, password: String, email: String): User!
  deleteUser(id: ID!): String!
  login(email: String!, password: String!): AuthPayload!
}

type AuthPayload {
  token: String!
  user: User!
}