type Report {
  id: ID!
  project: Project!
  title: String!
  content: String!
  format: ReportFormat!
  properties: ReportProperties!
  createdAt: Time!
  updatedAt: Time!
}

type ReportProperties {
  report: Report!
  generatedBy: User!
  generatedByAI: Boolean!
  status: ReportStatus!
  sourceChat: Chat
}

extend type Query {
  # Single report
  report(id: ID!): Report

  # Reports by project
  reports(projectId: ID!): [Report!]!

  # Reports by chat
  reportsByChat(sourceChatId: ID!): [Report!]!

  # Reports by generator
  reportsByGenerator(generatedById: ID!): [Report!]!

  # Reports by format
  reportsByFormat(
    format: ReportFormat!
  ): [Report!]!

  # Reports by status
  reportsByStatus(
    status: ReportStatus!
  ): [Report!]!

  # AI-generated reports
  aiReports(projectId: ID!): [Report!]!
}

extend type Mutation {
  # Reports
  createReport(input: CreateReportInput!): Report!
  updateReport(id: ID!, input: UpdateReportInput!): Report!
  deleteReport(id: ID!): Boolean!
}

input CreateReportInput {
  projectId: ID!
  title: String!
  content: String!
  format: ReportFormat!
  generatedBy: ID
  generatedByAi: Boolean
  status: ReportStatus
  sourceChatId: ID
}

input UpdateReportInput {
  title: String
  content: String
  format: ReportFormat
}
