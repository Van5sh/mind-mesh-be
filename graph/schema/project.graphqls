type Project {
  id: ID!
  name: String!
  description: String
  visibility: ProjectVisibility!
  owner: User!
  members: [ProjectMember!]!
  folders: [Folder!]!
  files: [ProjectFile!]!
  chats: [Chat!]!
  reports: [Report!]!
  flowcharts: [Flowchart!]!
  activityLogs: [ActivityLog!]!
  archivedAt: Time
  createdAt: Time!
  updatedAt: Time!
}

type ProjectMember {
  id: ID!
  role: ProjectRole!
  user: User!
  project: Project!
  createdAt: Time!
  updatedAt: Time!
}

type ProjectStats {
  memberCount: Int!
  fileCount: Int!
  chatCount: Int!
  reportCount: Int!
  flowchartCount: Int!
}

enum ProjectMemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

extend type Query {
  project(id: ID!): Project
  projects: [Project!]!
  projectsByOwner(ownerId: ID!): [Project!]!
  projectsForUser(userId: ID!): [Project!]!
  archivedProjectsByOwner(ownerId: ID!): [Project!]!
  archivedProjectsForUser(userId: ID!): [Project!]!
  projectMembers(projectId: ID!): [ProjectMember!]!
  projectStats(projectId: ID!): ProjectStats!
}

extend type Mutation {
  createProject(input: CreateProjectInput!): Project!
  updateProject(id: ID!, input: UpdateProjectInput!): Project!
  archiveProject(projectId: ID!): Boolean!
  restoreProject(projectId: ID!): Boolean!
  deleteProject(id: ID!): Boolean!
  transferProjectOwnership(
    input: TransferProjectOwnershipInput!
  ): Project!

  # Members
  addProjectMember(input: AddProjectMemberInput!): ProjectMember!
  updateProjectMemberRole(
    input: UpdateProjectMemberRoleInput!
  ): ProjectMember!
  removeProjectMember(
    projectId: ID!
    userId: ID!
  ): Boolean!
}

input CreateProjectInput {
  ownerId: ID!
  name: String!
  description: String
  visibility: ProjectVisibility!
}

input UpdateProjectInput {
  name: String
  description: String
  visibility: ProjectVisibility
}

input AddProjectMemberInput {
  projectId: ID!
  userId: ID!
  role: ProjectMemberRole!
}

input UpdateProjectMemberRoleInput {
  projectId: ID!
  userId: ID!
  role: ProjectMemberRole!
}

input TransferProjectOwnershipInput {
  projectId: ID!
  ownerId: ID!
}
