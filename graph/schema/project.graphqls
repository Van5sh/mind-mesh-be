type Project {
  id: ID!
  name: String!
  description: String
  visibility: ProjectVisibility!
  owner: User!
  members: [ProjectMember!]!
  folders: [Folder!]!
  files: [ProjectFile!]!
  chats: [Chat!]!
  reports: [Report!]!
  flowcharts: [Flowchart!]!
  activityLogs: [ActivityLog!]!
  archivedAt: Time
  createdAt: Time!
  updatedAt: Time!
}

type ProjectMember {
  id: ID!
  role: ProjectRole!
  user: User!
  project: Project!
  createdAt: Time!
  updatedAt: Time!
}

extend type Query {
  project(id: ID!): Project
  projects: [Project!]!
  archivedProjects: [Project!]!
  projectMembers(projectId: ID!): [ProjectMember!]!
}

extend type Mutation {
  createProject(input: CreateProjectInput!): Project!
  updateProject(input: UpdateProjectInput!): Project!
  archiveProject(projectId: ID!): Boolean!
  restoreProject(projectId: ID!): Boolean!

  addProjectMember(input: AddProjectMemberInput!): ProjectMember!
  updateProjectMemberRole(input: UpdateProjectMemberRoleInput!): ProjectMember!
  removeProjectMember(projectId: ID!, userId: ID!): Boolean!
}

input CreateProjectInput {
  name: String!
  ownerId: ID!
  description: String
  visibility: ProjectVisibility!
}

input UpdateProjectInput {
  projectId: ID!
  name: String!
  description: String
  visibility: ProjectVisibility!
}

input AddProjectMemberInput {
  projectId: ID!
  userId: ID!
  role: ProjectRole!
}

input UpdateProjectMemberRoleInput {
  projectId: ID!
  userId: ID!
  role: ProjectRole!
}
