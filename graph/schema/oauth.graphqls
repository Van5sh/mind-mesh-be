# ============================================================
# OAuth
# ============================================================

enum OAuthProvider {
  GOOGLE
  GITHUB
}

type OAuthAccount {
  id: ID!
  userId: ID!
  provider: OAuthProvider!
  providerUserId: String!
  createdAt: DateTime!
  updatedAt: DateTime!
}

input CreateOAuthAccountInput {
  userId: ID!
  provider: OAuthProvider!
  providerUserId: String!
}

extend type Mutation {
  createOAuthAccount(
    input: CreateOAuthAccountInput!
  ): OAuthAccount!
  deleteOAuthAccount(
    id: ID!
  ): Boolean!
}