# ============================================================
# Sessions
# ============================================================

type Session {
  id: ID!
  userId: ID!
  expiresAt: DateTime!
  createdAt: DateTime!
}

input CreateSessionInput {
  userId: ID!
  expiresAt: DateTime!
}

extend type Mutation {
  createSession(
    input: CreateSessionInput!
  ): Session!

  deleteSession(
    id: ID!
  ): Boolean!
}